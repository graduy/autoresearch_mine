{
  "experiment_id": "nanochat-local",
  "title": "Pinned nanochat autoresearch adapter on local RTX 4060",
  "hypothesis": "Establish a reproducible local baseline before testing budget-compatible train.py changes.",
  "source_papers": [
    {
      "title": "autoresearch",
      "url": "https://github.com/karpathy/autoresearch",
      "role": "evaluation protocol and fixed val_bpb loop"
    }
  ],
  "base_commit": "228791fb499afffb54b46200aca536f79142f117",
  "dataset_manifest_hash": "recorded_at_run_time",
  "evaluation_script": "prepare.py:evaluate_bpb",
  "primary_metric": "val_bpb",
  "metric_direction": "minimize",
  "secondary_metrics": ["training_seconds", "peak_vram_mb", "num_steps"],
  "constraints": {
    "max_runtime_seconds": 660,
    "max_cost_usd": 0.0,
    "max_vram_gb": 7.7,
    "max_runs": 8
  },
  "stages": {
    "baseline": {
      "command": ["uv", "run", "train.py"],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "pilot": {
      "command": ["uv", "run", "train.py"],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "full": {
      "command": ["uv", "run", "train.py"],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "multi_seed": {
      "command": ["uv", "run", "train.py"],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    }
  },
  "seeds": [17, 42, 3407],
  "acceptance_rule": "keep only if val_bpb improves over the best same-protocol result and all protected files remain unchanged",
  "stop_rule": "stop after four local runs, a crash requiring human intervention, or the configured time/cost limit",
  "human_approval": {
    "required": true,
    "status": "pending"
  }
}
