{
  "acceptance_rule": "keep only if val_bpb improves over the adapted baseline without violating the VRAM or runtime budget",
  "base_commit": "recorded_at_run_time",
  "constraints": {
    "max_cost_usd": 0.0,
    "max_runs": 8,
    "max_runtime_seconds": 660,
    "max_vram_gb": 7.7
  },
  "dataset_manifest_hash": "recorded_at_run_time",
  "evaluation_script": "prepare.py:evaluate_bpb",
  "experiment_id": "nanochat-rtx4060",
  "human_approval": {
    "required": true,
    "status": "pending"
  },
  "hypothesis": "Reducing only the per-device micro-batch should make the fixed evaluation chain executable within 8 GB VRAM while preserving the 5-minute optimization budget.",
  "metric_direction": "minimize",
  "primary_metric": "val_bpb",
  "protocol_changes": [
    "DEVICE_BATCH_SIZE 128 -> 32"
  ],
  "secondary_metrics": [
    "training_seconds",
    "peak_vram_mb",
    "num_steps"
  ],
  "seeds": [
    17,
    42,
    3407
  ],
  "source_papers": [
    {
      "role": "hardware adaptation guidance",
      "title": "autoresearch README small-compute guidance",
      "url": "https://github.com/karpathy/autoresearch#platform-support"
    }
  ],
  "stages": {
    "baseline": {
      "command": [
        "uv",
        "run",
        "train.py"
      ],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "full": {
      "command": [
        "uv",
        "run",
        "train.py"
      ],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "multi_seed": {
      "command": [
        "uv",
        "run",
        "train.py"
      ],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    },
    "pilot": {
      "command": [
        "uv",
        "run",
        "train.py"
      ],
      "metric_pattern": "^val_bpb:\\s*([0-9.]+)",
      "vram_pattern": "^peak_vram_mb:\\s*([0-9.]+)"
    }
  },
  "stop_rule": "stop after four local runs, an integrity failure, or the configured budget",
  "title": "Hardware-adapted nanochat autoresearch on RTX 4060 Laptop",
  "upstream_comparable": false
}
